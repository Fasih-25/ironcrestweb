# Copy to .env.local and fill in. Never commit real values.

# Show the real product screenshots (hero, story, reel, phone). false = illustrated placeholders.
NEXT_PUBLIC_SHOW_REAL_UI=false

# Public site URL (canonical, sitemap, OG) — used from S5
NEXT_PUBLIC_SITE_URL=https://ironcrest.example

# Build target: export (static, Hostinger shared) | standalone (Node) | empty (next start)
BUILD_TARGET=

# --- Demo form (S4) ---
# Forward demo requests to the Ironcrest API instead of handling them here
IRONCREST_API_URL=
# Static export only: where the browser posts the form (e.g. https://api.ironcrest.example/api/v1/public/demo-requests)
NEXT_PUBLIC_DEMO_ENDPOINT=
# Cloudflare Turnstile (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Email notification: either Resend or SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEMO_NOTIFY_TO=
DEMO_NOTIFY_FROM=
# Optional: store demo requests
DATABASE_URL=

# --- Analytics (S5, off by default, consent required) ---
NEXT_PUBLIC_ANALYTICS_SRC=
